{
	"name": "@batuda/server",
	"version": "2026.8.7",
	"type": "module",
	"scripts": {
		"dev": "portless run --name api.batuda node --watch --env-file=../../.env --import tsx src/main.ts",
		"dev:mcp": "node --env-file=../../.env --import tsx src/mcp-stdio.ts",
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"start": "node dist/main.mjs",
		"migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate.ts",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:boot": "pnpm build && vitest run src/main.boot.test.ts --config vitest.boot.config.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1026.0",
		"@aws-sdk/s3-request-presigner": "^3.1026.0",
		"@better-auth/api-key": "1.6.11",
		"@better-auth/oauth-provider": "1.6.11",
		"@effect/platform-node": "4.0.0-beta.102",
		"@effect/sql-pg": "4.0.0-beta.102",
		"better-auth": "1.6.11",
		"effect": "4.0.0-beta.102",
		"imapflow": "^1.3.2",
		"kysely": "^0.28.15",
		"nodemailer": "^8.0.7",
		"pg": "^8.20.0",
		"sharp": "^0.34.2"
	},
	"devDependencies": {
		"@batuda/auth": "workspace:*",
		"@batuda/calendar": "workspace:*",
		"@batuda/controllers": "workspace:*",
		"@batuda/domain": "workspace:*",
		"@batuda/email": "workspace:*",
		"@batuda/instructions": "workspace:*",
		"@batuda/observability": "workspace:*",
		"@batuda/research": "workspace:*",
		"@batuda/ui": "workspace:*",
		"@types/node": "^22.15.0",
		"@types/nodemailer": "^8.0.0",
		"@types/pg": "^8.20.0",
		"tsdown": "^0.22.7",
		"tsx": "^4.20.3",
		"typescript": "^5.9.3",
		"vitest": "^4.1.4"
	},
	"private": true
}
