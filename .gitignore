# Dependencies
node_modules/

# Build outputs
dist/
.wrangler/
*.tsbuildinfo

# Turbo
.turbo/

# Playwright test artefacts. Run from the repo root rather than the app, and
# Playwright drops them here instead.
apps/*/test-results/
apps/*/playwright-report/
/test-results/
/playwright-report/

# Environment
.env
.env.local
.env.*.local
.env.cloud
.env.pr-media
apps/*/.env.cloud

# Local secrets — never commit (TLS keys, dev tokens, etc.)
secrets/

# Cloud CLI audit log (appended by confirm-cloud on every --env cloud write)
cloud-audit.log

# Database
*.db

# Logs
*.log

# Local dev email catcher (LocalInboxProviderLive output)
apps/server/.dev-inbox/

# Cache
.cache/

# Nix
result

# OS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test
coverage/

# Direnv
.direnv/

# Web
.tanstack

# AI
.claude/worktrees
.claude/*.lock
# Eval corpora hold real companies somebody verified by hand; only the
# `.example` templates are shared.
eval/*.json
!eval/*.example.json
