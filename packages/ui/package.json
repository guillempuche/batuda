{
	"name": "@batuda/ui",
	"version": "2026.7.28",
	"type": "module",
	"types": "./dist/index.d.mts",
	"main": "./dist/index.mjs",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./blocks": {
			"development": "./src/blocks/index.ts",
			"types": "./dist/blocks/index.d.mts",
			"import": "./dist/blocks/index.mjs"
		},
		"./layout": {
			"development": "./src/layout/index.ts",
			"types": "./dist/layout/index.d.mts",
			"import": "./dist/layout/index.mjs"
		},
		"./pri": {
			"development": "./src/pri/index.ts",
			"types": "./dist/pri/index.d.mts",
			"import": "./dist/pri/index.mjs"
		},
		"./tokens.css": "./src/tokens.css",
		"./tailwind.css": "./src/tailwind.css"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"check-types": "tsc --noEmit",
		"check-contrast": "tsx scripts/check-contrast.ts"
	},
	"dependencies": {
		"@base-ui/react": "1.6.0",
		"@tiptap/core": "^3.28.0",
		"@tiptap/pm": "^3.28.0",
		"effect": "4.0.0-beta.102",
		"styled-components": "6.3.12"
	},
	"peerDependencies": {
		"react": "^19",
		"react-dom": "^19",
		"tailwindcss": ">=4"
	},
	"devDependencies": {
		"@types/react": "19.2.17",
		"tailwindcss": ">=4",
		"tsdown": "^0.22.7",
		"tsx": "^4.20.3",
		"typescript": "^5.9.3"
	},
	"private": false,
	"files": [
		"dist",
		"src/tokens.css",
		"src/tailwind.css"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"import": "./dist/index.mjs"
			},
			"./blocks": {
				"types": "./dist/blocks/index.d.mts",
				"import": "./dist/blocks/index.mjs"
			},
			"./layout": {
				"types": "./dist/layout/index.d.mts",
				"import": "./dist/layout/index.mjs"
			},
			"./pri": {
				"types": "./dist/pri/index.d.mts",
				"import": "./dist/pri/index.mjs"
			},
			"./tokens.css": {
				"default": "./dist/tokens.css"
			},
			"./tailwind.css": {
				"default": "./dist/tailwind.css"
			}
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/guillempuche/batuda.git",
		"directory": "packages/ui"
	}
}
